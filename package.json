{
  "name": "n8n-workflows-enterprise",
  "version": "2.0.0",
  "description": "Enterprise-grade n8n workflows for multi-domain automation",
  "main": "scripts/deploy.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jdorge/n8n-workflows-enterprise.git"
  },
  "scripts": {
    "deploy": "node scripts/deploy.js",
    "deploy:all": "node scripts/deploy.js --all",
    "test": "node scripts/test.js",
    "validate": "node scripts/validators.js",
    "start": "n8n start",
    "dev": "n8n start --tunnel",
    "backup": "node scripts/backup.js",
    "lint": "eslint scripts/**/*.js",
    "precommit": "npm run validate && npm run test"
  },
  "keywords": [
    "n8n",
    "automation",
    "workflows",
    "enterprise",
    "crm",
    "hubspot",
    "notion",
    "slack"
  ],
  "author": "Your Company",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "@notionhq/client": "^2.2.15",
    "@slack/web-api": "^6.10.0",
    "winston": "^3.11.0",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0"
  }
}
